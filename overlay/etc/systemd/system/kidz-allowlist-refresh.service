[Unit]
Description=Refresh Kidz OS web allowlist
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/kidz-refresh-allowlist.sh
# ExecStartPost failures are left fatal so systemd marks refresh/apply problems immediately.
ExecStartPost=/usr/local/bin/kidz-apply-firewall.sh
